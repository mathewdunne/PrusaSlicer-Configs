# Ignore everything by default
*

# Keep this file
!.gitignore

# --- Profile folders ---
# A directory excluded by "*" cannot have files re-included inside it, so each
# folder is un-ignored first, its contents re-ignored, then the keepers listed.
!printer/
printer/*
!printer/*Voron*.ini
!printer/voron_bed*.*
!physical_printer/
physical_printer/*
!physical_printer/Poseidon.ini
!print/
print/*
!print/*VT*.ini
!print/*INDX*.ini
!filament/
filament/*
!filament/*VT*.ini
!filament/*INDX*.ini

# --- Exclude noisy stuff even if inside un-ignored dirs ---
# (these can show up in profile folders sometimes)
*.bak
*.tmp
*.lock
*.autosave

# --- Still ignore logs, cache, previews, recent projects ---
logs/
cache/
http-cache/
gcodeviewer-cache/
sl1-cache/
recent_*.json
window-state.json
